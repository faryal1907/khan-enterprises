generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                               String                   @id @default(uuid())
  email                            String                   @unique
  passwordHash                     String
  fullName                         String
  phoneNumber                      String?
  role                             UserRole
  status                           UserStatus               @default(ACTIVE)
  branchId                         String?
  vendorId                         String?
  createdAt                        DateTime                 @default(now())
  updatedAt                        DateTime                 @updatedAt
  fcmTokens                        String[]                 @default([])
  auditLogs                        AuditLog[]
  managedBranches                  Branch[]                 @relation("BranchManager")
  documents                        Document[]
  recordedExpenses                 Expense[]
  customerOrders                   Order[]                  @relation("OrderCustomer")
  processedOrders                  Order[]                  @relation("OrderProcessedBy")
  orderAlerts                      OrderAlert[]
  customerPartOrders               PartOrder[]              @relation("PartOrderCustomer")
  processedPartOrders              PartOrder[]              @relation("PartOrderProcessedBy")
  processedPartPaymentTransactions PartPaymentTransaction[] @relation("PartPaymentTransactionProcessedBy")
  passwordResetTokens              PasswordResetToken[]
  processedPaymentTransactions     PaymentTransaction[]     @relation("PaymentTransactionProcessedBy")
  receivablePaymentsRecorded       ReceivablePayment[]      @relation("ReceivablePaymentRecordedBy")
  refreshTokens                    RefreshToken[]
  stockMovements                   StockMovement[]
  branch                           Branch?                  @relation(fields: [branchId], references: [id])
  vendor                           Vendor?                  @relation(fields: [vendorId], references: [id])
  vendorAllocationsRecorded        VendorAllocation[]       @relation("VendorAllocationRecordedBy")
  vendorDefectiveReturnsRecorded   VendorDefectiveReturn[]  @relation("VendorDefectiveReturnRecordedBy")
  vendorPaymentsRecorded           VendorPayment[]          @relation("VendorPaymentRecordedBy")

  @@index([email])
  @@index([role])
  @@index([branchId])
  @@index([vendorId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model Branch {
  id                  String                     @id @default(uuid())
  name                String
  city                String
  address             String
  phoneNumber         String?
  latitude            Float?
  longitude           Float?
  managerId           String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  bikeInventory       BikeUnit[]
  manager             User?                      @relation("BranchManager", fields: [managerId], references: [id])
  expenses            Expense[]
  orders              Order[]
  partInventory       PartInventory[]
  partOrders          PartOrder[]
  users               User[]
  allocationPartLines VendorAllocationPartLine[]

  @@unique([name, city])
}

model Vendor {
  id                String                  @id @default(uuid())
  name              String
  contactPerson     String?
  phoneNumber       String?
  email             String?
  address           String?
  isActive          Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  commissionRate    Decimal                 @default(0) @db.Decimal(5, 2)
  suppliedBikes     BikeUnit[]
  purchaseOrders    PurchaseOrder[]
  receivableEntries ReceivableEntry[]
  staff             User[]
  allocations       VendorAllocation[]
  defectiveReturns  VendorDefectiveReturn[]
  payments          VendorPayment[]
}

model BikeModel {
  id             String     @id @default(uuid())
  brand          String
  modelName      String
  year           Int
  engineCapacity String?
  colors         String[]   @default([])
  description    String?
  basePrice      Decimal    @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  bikes          BikeUnit[]

  @@index([brand])
  @@index([modelName])
}

model BikeUnit {
  id                    String            @id @default(uuid())
  vendorId              String
  branchId              String
  modelId               String
  chassisNumber         String            @unique
  engineNumber          String            @unique
  serialNumber          String?
  status                BikeStatus        @default(AVAILABLE)
  price                 Decimal?          @db.Decimal(12, 2)
  purchasePrice         Decimal?          @db.Decimal(12, 2)
  purchaseCost          Decimal?          @db.Decimal(12, 2)
  color                 String?
  media                 String[]          @default([])
  onlineDiscountPercent Decimal           @default(0) @db.Decimal(5, 2)
  actualSalePrice       Decimal?          @db.Decimal(12, 2)
  reservedUntil         DateTime?
  soldAt                DateTime?
  vendorAllocationId    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  branch                Branch            @relation(fields: [branchId], references: [id])
  model                 BikeModel         @relation(fields: [modelId], references: [id])
  vendorAllocation      VendorAllocation? @relation(fields: [vendorAllocationId], references: [id])
  vendor                Vendor            @relation(fields: [vendorId], references: [id])
  documents             Document[]
  orders                Order[]

  @@index([status])
  @@index([branchId])
  @@index([modelId])
  @@index([vendorId])
  @@index([reservedUntil])
  @@index([vendorAllocationId])
}

model Part {
  id              String                     @id @default(uuid())
  name            String
  sku             String                     @unique
  category        String
  description     String?
  sellingPrice    Decimal                    @db.Decimal(12, 2)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  purchaseCost    Decimal?                   @db.Decimal(12, 2)
  inventories     PartInventory[]
  partOrders      PartOrder[]
  allocationLines VendorAllocationPartLine[]

  @@index([category])
}

model PartInventory {
  id                    String                          @id @default(uuid())
  partId                String
  branchId              String
  quantity              Int                             @default(0)
  reservedQuantity      Int                             @default(0)
  reorderLevel          Int                             @default(5)
  onlineDiscountPercent Decimal                         @default(0) @db.Decimal(5, 2)
  updatedAt             DateTime                        @updatedAt
  branch                Branch                          @relation(fields: [branchId], references: [id])
  part                  Part                            @relation(fields: [partId], references: [id])
  partOrders            PartOrder[]
  stockMovements        StockMovement[]
  defectiveReturnLines  VendorDefectiveReturnPartLine[]

  @@unique([partId, branchId])
  @@index([branchId])
}

model StockMovement {
  id            String                @id @default(uuid())
  inventoryId   String
  movementType  InventoryMovementType
  quantity      Int
  reason        String?
  performedById String?
  createdAt     DateTime              @default(now())
  inventory     PartInventory         @relation(fields: [inventoryId], references: [id])
  performedBy   User?                 @relation(fields: [performedById], references: [id])

  @@index([inventoryId])
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  bikeId            String
  branchId          String
  customerName      String
  customerPhone     String
  customerCNIC      String?
  customerAddress   String?
  isOnlineOrder     Boolean              @default(false)
  appliedDiscount   Decimal?             @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentAccountId  String?
  status            OrderStatus          @default(PENDING_PAYMENT)
  paymentVerified   Boolean              @default(false)
  orderType         OrderType            @default(ONSITE)
  reservationExpiry DateTime?
  pickupType        PickupType           @default(ONSITE_PICKUP)
  saleDate          DateTime?
  expiresAt         DateTime?
  processedById     String?
  customerId        String?
  totalAmount       Decimal              @default(0) @db.Decimal(12, 2)
  paidAmount        Decimal              @default(0) @db.Decimal(12, 2)
  balanceDue        Decimal              @default(0) @db.Decimal(12, 2)
  isInstallmentPlan Boolean              @default(false)
  paymentState      PaymentState         @default(DUE)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  delivery          DeliveryRequest?
  documents         Document[]
  bike              BikeUnit             @relation(fields: [bikeId], references: [id])
  branch            Branch               @relation(fields: [branchId], references: [id])
  customer          User?                @relation("OrderCustomer", fields: [customerId], references: [id])
  paymentAccount    Account?             @relation("OrderPaymentAccount", fields: [paymentAccountId], references: [id])
  processedBy       User?                @relation("OrderProcessedBy", fields: [processedById], references: [id])
  alerts            OrderAlert[]
  allocations       PaymentAllocation[]
  transactions      PaymentTransaction[]

  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@index([customerId])
}

model OrderAlert {
  id          String     @id @default(uuid())
  orderId     String?
  partOrderId String?
  userId      String
  isRead      Boolean    @default(false)
  alertType   String
  createdAt   DateTime   @default(now())
  order       Order?     @relation(fields: [orderId], references: [id])
  partOrder   PartOrder? @relation(fields: [partOrderId], references: [id])
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model PartOrder {
  id                String                   @id @default(uuid())
  orderNumber       String                   @unique
  partId            String
  partInventoryId   String
  branchId          String
  customerName      String
  customerPhone     String
  customerAddress   String?
  quantity          Int
  amount            Decimal                  @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentAccountId  String?
  status            OrderStatus              @default(PENDING_PAYMENT)
  paymentVerified   Boolean                  @default(false)
  orderType         OrderType                @default(ONSITE)
  reservationExpiry DateTime?
  pickupType        PickupType               @default(ONSITE_PICKUP)
  saleDate          DateTime?
  expiresAt         DateTime?
  processedById     String?
  customerId        String?
  paidAmount        Decimal                  @default(0) @db.Decimal(12, 2)
  balanceDue        Decimal                  @default(0) @db.Decimal(12, 2)
  isInstallmentPlan Boolean                  @default(false)
  paymentState      PaymentState             @default(DUE)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  delivery          DeliveryRequest?
  alerts            OrderAlert[]
  branch            Branch                   @relation(fields: [branchId], references: [id])
  customer          User?                    @relation("PartOrderCustomer", fields: [customerId], references: [id])
  part              Part                     @relation(fields: [partId], references: [id])
  partInventory     PartInventory            @relation(fields: [partInventoryId], references: [id])
  paymentAccount    Account?                 @relation("PartOrderPaymentAccount", fields: [paymentAccountId], references: [id])
  processedBy       User?                    @relation("PartOrderProcessedBy", fields: [processedById], references: [id])
  transactions      PartPaymentTransaction[]
  allocations       PaymentAllocation[]

  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@index([customerId])
}

model PaymentTransaction {
  id                    String              @id @default(uuid())
  orderId               String?
  accountId             String?
  gatewayReference      String?             @unique
  idempotencyKey        String?             @unique
  amount                Decimal             @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus       @default(PENDING)
  gatewayResponse       Json?
  failureReason         String?
  paymentProofUrl       String?
  verifiedAt            DateTime?
  verifiedById          String?
  webhookReceivedAt     DateTime?
  createdAt             DateTime            @default(now())
  transactionDate       DateTime?
  updatedAt             DateTime            @updatedAt
  processedById         String?
  isReversed            Boolean             @default(false)
  originalAmount        Decimal?            @db.Decimal(12, 2)
  reversalTransactionId String?
  reversedAt            DateTime?
  reversedById          String?
  allocations           PaymentAllocation[]
  account               Account?            @relation(fields: [accountId], references: [id])
  order                 Order?              @relation(fields: [orderId], references: [id])
  processedBy           User?               @relation("PaymentTransactionProcessedBy", fields: [processedById], references: [id])

  @@index([status])
  @@index([gatewayReference])
  @@index([orderId])
  @@index([isReversed])
}

model PartPaymentTransaction {
  id                    String              @id @default(uuid())
  partOrderId           String?
  accountId             String?
  gatewayReference      String?             @unique
  idempotencyKey        String?             @unique
  amount                Decimal             @db.Decimal(12, 2)
  method                PaymentMethod
  status                PaymentStatus       @default(PENDING)
  gatewayResponse       Json?
  failureReason         String?
  paymentProofUrl       String?
  verifiedAt            DateTime?
  verifiedById          String?
  webhookReceivedAt     DateTime?
  createdAt             DateTime            @default(now())
  transactionDate       DateTime?
  updatedAt             DateTime            @updatedAt
  processedById         String?
  isReversed            Boolean             @default(false)
  originalAmount        Decimal?            @db.Decimal(12, 2)
  reversalTransactionId String?
  reversedAt            DateTime?
  reversedById          String?
  account               Account?            @relation(fields: [accountId], references: [id])
  partOrder             PartOrder?          @relation(fields: [partOrderId], references: [id])
  processedBy           User?               @relation("PartPaymentTransactionProcessedBy", fields: [processedById], references: [id])
  allocations           PaymentAllocation[]

  @@index([status])
  @@index([gatewayReference])
  @@index([partOrderId])
  @@index([isReversed])
}

/// A person or entity that the business owes money to.
/// Acts as a payable ledger account (mirroring CustomerReceivable on the receivables side).
model PayeeAccount {
  id        String    @id @default(uuid())
  name      String
  type      PayeeType @default(OTHER)
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([name])
  @@index([type])
}

model Expense {
  id             String          @id @default(uuid())
  amount         Decimal         @db.Decimal(12, 2)
  date           DateTime
  category       ExpenseCategory
  description    String?
  /// The payee this expense is owed to (required for AP tracking)
  payeeAccountId String?
  branchId       String
  recordedById   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  branch         Branch          @relation(fields: [branchId], references: [id])
  payeeAccount   PayeeAccount?   @relation(fields: [payeeAccountId], references: [id])
  recordedBy     User            @relation(fields: [recordedById], references: [id])

  @@index([branchId])
  @@index([recordedById])
  @@index([date])
  @@index([payeeAccountId])
}

model DeliveryRequest {
  id                  String         @id @default(uuid())
  orderId             String?        @unique
  partOrderId         String?        @unique
  deliveryAddress     String
  preferredTimeWindow String?
  contactNumber       String
  latitude            Float?
  longitude           Float?
  distanceFromBranch  Float?
  deliveryCost        Decimal?       @db.Decimal(12, 2)
  status              DeliveryStatus @default(REQUESTED)
  approvedAt          DateTime?
  deliveredAt         DateTime?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  order               Order?         @relation(fields: [orderId], references: [id])
  partOrder           PartOrder?     @relation(fields: [partOrderId], references: [id])

  @@index([orderId])
  @@index([partOrderId])
  @@index([status])
}

model Document {
  id           String    @id @default(uuid())
  fileName     String
  fileUrl      String
  mimeType     String
  fileSize     Int
  fileType     FileType
  bikeId       String?
  orderId      String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  bike         BikeUnit? @relation(fields: [bikeId], references: [id])
  order        Order?    @relation(fields: [orderId], references: [id])
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id])

  @@index([fileType])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  userRole   UserRole?
  action     AuditAction
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Account {
  id                      String                   @id @default(uuid())
  code                    String                   @unique
  name                    String
  category                AccountCategory
  subtype                 AccountSubtype
  accountNumber           String?
  openingBalance          Decimal                  @default(0) @db.Decimal(12, 2)
  isActive                Boolean                  @default(true)
  isSystem                Boolean                  @default(false)
  lines                   JournalEntryLine[]
  orderPayments           Order[]                  @relation("OrderPaymentAccount")
  partOrderPayments       PartOrder[]              @relation("PartOrderPaymentAccount")
  partPaymentTransactions PartPaymentTransaction[]
  payments                PaymentTransaction[]
  receivablePayments      ReceivablePayment[]
  vendorPayments          VendorPayment[]          @relation("VendorPaymentFromAccount")
}

model JournalEntry {
  id                     String                 @id @default(uuid())
  entryNo                String                 @unique
  date                   DateTime               @default(now())
  description            String
  sourceRef              String?
  notes                  String?
  status                 JournalStatus          @default(POSTED)
  isManual               Boolean                @default(false)
  createdAt              DateTime               @default(now())
  isReversal             Boolean                @default(false)
  reversesJournalEntryId String?
  lines                  JournalEntryLine[]
  receivablePayment      ReceivablePayment?
  vendorAllocation       VendorAllocation?
  vendorDefectiveReturn  VendorDefectiveReturn?
  vendorPayment          VendorPayment?

  @@index([createdAt])
  @@index([isReversal])
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
}

model PurchaseOrder {
  id        String              @id @default(uuid())
  poNumber  String              @unique
  vendorId  String
  type      String
  totalCost Decimal             @db.Decimal(12, 2)
  status    POStatus            @default(PENDING)
  payable   Payable?
  vendor    Vendor              @relation(fields: [vendorId], references: [id])
  items     PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  modelId         String?
  partId          String?
  branchId        String
  quantity        Int
  purchasePrice   Decimal       @db.Decimal(12, 2)
  salePrice       Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Payable {
  id            String              @id @default(uuid())
  ref           String              @unique
  type          PayableType
  partyName     String
  description   String?
  total         Decimal             @db.Decimal(12, 2)
  paid          Decimal             @default(0) @db.Decimal(12, 2)
  remaining     Decimal             @db.Decimal(12, 2)
  dueDate       DateTime?
  status        PaymentState        @default(DUE)
  poId          String?             @unique
  /// Direct link to the expense that created this payable (replaces fragile ref-string matching)
  expenseId     String?             @unique
  purchaseOrder PurchaseOrder?      @relation(fields: [poId], references: [id])
  allocations   PaymentAllocation[]
}

model PaymentAllocation {
  id                       String                  @id @default(uuid())
  paymentId                String
  orderId                  String?
  partOrderId              String?
  payableId                String?
  allocatedAmount          Decimal                 @db.Decimal(12, 2)
  partPaymentTransactionId String?
  order                    Order?                  @relation(fields: [orderId], references: [id])
  partOrder                PartOrder?              @relation(fields: [partOrderId], references: [id])
  partPaymentTransaction   PartPaymentTransaction? @relation(fields: [partPaymentTransactionId], references: [id])
  payable                  Payable?                @relation(fields: [payableId], references: [id])
  payment                  PaymentTransaction      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

/// Records a cash payment made TO a vendor (money out, vendor prepaid balance increases).
model VendorPayment {
  id             String        @id @default(uuid())
  vendorId       String
  /// The account funds were drawn from (Cash, Bank, Owner Capital, etc.)
  fromAccountId  String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @default(now())
  notes          String?
  /// The auto-posted journal entry for this payment (DR Vendor Prepaid / CR fromAccount)
  journalEntryId String?       @unique
  recordedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  fromAccount    Account       @relation("VendorPaymentFromAccount", fields: [fromAccountId], references: [id])
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  recordedBy     User?         @relation("VendorPaymentRecordedBy", fields: [recordedById], references: [id])
  vendor         Vendor        @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([date])
}

/// Records the allocation of received inventory against a vendor's prepaid balance.
/// One allocation event can cover multiple bikes and/or parts in a single delivery.
model VendorAllocation {
  id             String                     @id @default(uuid())
  vendorId       String
  /// Total cost of all inventory in this allocation event
  totalAmount    Decimal                    @db.Decimal(12, 2)
  date           DateTime                   @default(now())
  notes          String?
  /// The auto-posted journal entry (DR Inventory / CR Vendor Prepaid)
  journalEntryId String?                    @unique
  recordedById   String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  bikes          BikeUnit[]
  journalEntry   JournalEntry?              @relation(fields: [journalEntryId], references: [id])
  recordedBy     User?                      @relation("VendorAllocationRecordedBy", fields: [recordedById], references: [id])
  vendor         Vendor                     @relation(fields: [vendorId], references: [id])
  partLines      VendorAllocationPartLine[]

  @@index([vendorId])
  @@index([date])
}

/// A single part line inside a VendorAllocation (e.g. 10x spark plugs @ Rs. 450 each).
model VendorAllocationPartLine {
  id           String           @id @default(uuid())
  allocationId String
  partId       String
  branchId     String
  quantity     Int
  unitCost     Decimal          @db.Decimal(12, 2)
  totalCost    Decimal          @db.Decimal(12, 2)
  allocation   VendorAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id])
  part         Part             @relation(fields: [partId], references: [id])

  @@index([allocationId])
  @@index([partId])
}

/// Records a return of defective inventory to a vendor.
model VendorDefectiveReturn {
  id             String                          @id @default(uuid())
  vendorId       String
  /// Total value of returned items
  totalAmount    Decimal                         @db.Decimal(12, 2)
  date           DateTime                        @default(now())
  notes          String?
  /// The auto-posted journal entry (CR Inventory / DR Vendor Prepaid)
  journalEntryId String?                         @unique
  recordedById   String?
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  journalEntry   JournalEntry?                   @relation(fields: [journalEntryId], references: [id])
  recordedBy     User?                           @relation("VendorDefectiveReturnRecordedBy", fields: [recordedById], references: [id])
  vendor         Vendor                          @relation(fields: [vendorId], references: [id])
  bikes          VendorDefectiveReturnBike[]
  partLines      VendorDefectiveReturnPartLine[]

  @@index([vendorId])
  @@index([date])
}

/// A single bike unit referenced in a defective return.
model VendorDefectiveReturnBike {
  id            String                @id @default(uuid())
  returnId      String
  chassisNumber String
  modelBrand    String
  modelName     String
  unitCost      Decimal               @db.Decimal(12, 2)
  return        VendorDefectiveReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// A single part line inside a VendorDefectiveReturn.
model VendorDefectiveReturnPartLine {
  id              String                @id @default(uuid())
  returnId        String
  partInventoryId String
  quantity        Int
  unitCost        Decimal               @db.Decimal(12, 2)
  totalCost       Decimal               @db.Decimal(12, 2)
  partInventory   PartInventory         @relation(fields: [partInventoryId], references: [id])
  return          VendorDefectiveReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([partInventoryId])
}

/// A person or entity that owes the business money.
/// Customers auto-link via phone. Other party types use manual entries.
model ReceivableParty {
  id            String              @id @default(uuid())
  name          String
  partyType     ReceivablePartyType @default(CUSTOMER)
  phone         String?
  email         String?
  address       String?
  notes         String?
  isActive      Boolean             @default(true)
  /// For CUSTOMER parties this mirrors the customerPhone on orders
  customerPhone String?             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  entries       ReceivableEntry[]

  @@index([name])
  @@index([partyType])
  @@index([customerPhone])
}

/// A manually-created receivable line for non-order parties
/// (e.g. a loan to a vendor, advance to an employee, etc.)
model ReceivableEntry {
  id          String              @id @default(uuid())
  partyId     String
  /// Optional: if this receivable was sourced from a vendor's prepaid balance
  vendorId    String?
  amount      Decimal             @db.Decimal(12, 2)
  description String
  date        DateTime            @default(now())
  dueDate     DateTime?
  paidAmount  Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue  Decimal             @db.Decimal(12, 2)
  status      PaymentState        @default(DUE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  party       ReceivableParty     @relation(fields: [partyId], references: [id])
  vendor      Vendor?             @relation(fields: [vendorId], references: [id])
  payments    ReceivablePayment[]

  @@index([partyId])
  @@index([vendorId])
  @@index([date])
}

/// A payment collected against a manual ReceivableEntry
model ReceivablePayment {
  id                     String          @id @default(uuid())
  entryId                String
  amount                 Decimal         @db.Decimal(12, 2)
  method                 PaymentMethod
  accountId              String?
  notes                  String?
  journalEntryId         String?         @unique
  recordedById           String?
  collectedAt            DateTime        @default(now())
  createdAt              DateTime        @default(now())
  isReversed             Boolean         @default(false)
  reversalJournalEntryId String?
  reversedAt             DateTime?
  reversedById           String?
  account                Account?        @relation(fields: [accountId], references: [id])
  entry                  ReceivableEntry @relation(fields: [entryId], references: [id])
  journalEntry           JournalEntry?   @relation(fields: [journalEntryId], references: [id])
  recordedBy             User?           @relation("ReceivablePaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([entryId])
  @@index([isReversed])
}

model ReceivablesAlert {
  id                String       @id @default(uuid())
  customerPhone     String       @unique
  customerName      String
  lastNotifiedAt    DateTime     @default(now())
  notificationCount Int          @default(0)
  outstandingAmount Decimal      @db.Decimal(12, 2)
  status            PaymentState
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([customerPhone])
}

